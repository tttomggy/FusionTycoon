# Rojo build output
*.rbxl
*.rbxlx
*.rbxm
*.rbxmx

# TycoonTemplate.rbxm is source content (default.project.json maps it to
# ReplicatedStorage.TycoonTemplate), not a build artifact - excluding it
# would leave the plot-cloning system unreproducible on a fresh clone.
!TycoonTemplate.rbxm

# Same reasoning for the imported VFX pieces extracted from user-supplied
# Toolbox packs: real source content (Rojo auto-syncs any .rbxm found inside
# this already-$path'd folder, no separate project.json entry needed), not
# build output.
!src/ReplicatedStorage/Shared/VFX/*.rbxm

# Rojo sourcemap
sourcemap.json

# Wally packages (the vendored server Packages folder is tracked)
/Packages/
wally.lock
DevPackages/

# Aftman/Foreman tool caches
.aftman/

# OS files
.DS_Store
Thumbs.db

# Editor files
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/

# Logs
*.log

# Luau type-checker artifacts (regenerate via the commands in aftman.toml)
globalTypes.d.luau
